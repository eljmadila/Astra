# ==============================================================================
# Astra — Environment Configuration Template
# Copy this file to .env or configure in your deployment environment / User Secrets.
# NEVER commit real credentials to version control.
# ==============================================================================

# ASP.NET Core Runtime Environment (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development

# SQL Server Database Connection
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=AstraDb;User Id=sa;Password=Astra_Strong_Pass_2026!;TrustServerCertificate=True;MultipleActiveResultSets=true

# Initial Seeded Administrator Account (Never commit real passwords)
Astra__Admin__Email=admin@astra.internal
Astra__Admin__Password=Astra_Admin_Init_2026!
Astra__Admin__Name=System Administrator
Astra__Admin__Department=Executive Governance

# Outbound Email Configuration (SMTP)
EmailSettings__SmtpHost=mailpit
EmailSettings__SmtpPort=1025
EmailSettings__FromEmail=noreply@astra.internal
EmailSettings__FromName=Astra Portal Notifications
EmailSettings__EnableSsl=false

# Docker SQL Server Credentials
MSSQL_SA_PASSWORD=Astra_Strong_Pass_2026!
ACCEPT_EULA=Y
