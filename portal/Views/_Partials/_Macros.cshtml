@{
  var svgSize = ViewData["LogoSize"] as string ?? "32";
}

<span class="d-inline-flex align-items-center">
  <svg width="@svgSize" height="@svgSize" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" class="astra-brand-mark">
    <defs>
      <!-- Radiant Cyan to Electric Violet Celestial Gradients -->
      <linearGradient id="astraGradPrimary" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#06B6D4" />
        <stop offset="50%" stop-color="#3B82F6" />
        <stop offset="100%" stop-color="#8B5CF6" />
      </linearGradient>

      <linearGradient id="astraStarGrad" x1="50%" y1="0%" x2="50%" y2="100%">
        <stop offset="0%" stop-color="#67E8F9" />
        <stop offset="50%" stop-color="#38BDF8" />
        <stop offset="100%" stop-color="#2563EB" />
      </linearGradient>

      <linearGradient id="astraConstellation" x1="0%" y1="100%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#A78BFA" />
        <stop offset="100%" stop-color="#38BDF8" />
      </linearGradient>

      <filter id="astraGlow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="0" dy="1" stdDeviation="1.5" flood-color="#06B6D4" flood-opacity="0.45" />
      </filter>
    </defs>

    <!-- Deep Space Navy Rounded Container -->
    <rect width="36" height="36" rx="9" fill="#0B0F19" />

    <!-- Radiant Apex Star (Astra Crown) -->
    <path d="M18 3L19.5 8.5L25 10L19.5 11.5L18 17L16.5 11.5L11 10L16.5 8.5L18 3Z" fill="url(#astraStarGrad)" filter="url(#astraGlow)" />

    <!-- Geometric Letter 'A' Outer Frame -->
    <path d="M18 13L8 31H12.5L15.5 25H20.5L23.5 31H28L18 13Z" fill="url(#astraGradPrimary)" />

    <!-- Inner Cutout of Letter 'A' -->
    <path d="M18 18L16.5 22H19.5L18 18Z" fill="#0B0F19" />

    <!-- Constellation Network Lattice (Staff Allocation Bridges) -->
    <line x1="12" y1="27" x2="16.5" y2="22" stroke="url(#astraConstellation)" stroke-width="1.2" opacity="0.8" />
    <line x1="16.5" y1="22" x2="24" y2="27" stroke="url(#astraConstellation)" stroke-width="1.2" opacity="0.8" />
    <line x1="10" y1="30" x2="19.5" y2="22" stroke="url(#astraConstellation)" stroke-width="1" opacity="0.6" />
    <line x1="20" y1="19" x2="26" y2="30" stroke="url(#astraConstellation)" stroke-width="1" opacity="0.7" />

    <!-- Interconnected Constellation Nodes -->
    <circle cx="18" cy="10" r="1.5" fill="#E0F2FE" />
    <circle cx="16.5" cy="22" r="1.3" fill="#67E8F9" />
    <circle cx="19.5" cy="22" r="1.3" fill="#A78BFA" />
    <circle cx="11.5" cy="28.5" r="1.2" fill="#38BDF8" />
    <circle cx="24.5" cy="28.5" r="1.2" fill="#C084FC" />
  </svg>
</span>
