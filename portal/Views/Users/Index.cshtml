@model AspnetCoreMvcFull.ViewModels.Users.UserIndexViewModel
@{
  ViewData["Title"] = "User Management — Astra";
}

<div class="row">
  <div class="col-12">
    <!-- Header Card -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
      <div>
        <h4 class="fw-bold mb-1"><span class="text-muted fw-light">Administration /</span> User Management</h4>
        <p class="text-muted mb-0 small">Manage corporate access, roles, account activation, and security profiles.</p>
      </div>
      <div>
        <a asp-action="Create" class="btn btn-primary">
          <i class="bx bx-user-plus me-1"></i> Add New User
        </a>
      </div>
    </div>

    <!-- Filters & Search Card -->
    <div class="card mb-4 shadow-sm border-0">
      <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
          <div class="col-md-5">
            <div class="input-group input-group-merge">
              <span class="input-group-text"><i class="bx bx-search"></i></span>
              <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by name, email, department..." />
            </div>
          </div>
          <div class="col-md-3">
            <select name="roleFilter" class="form-select">
              <option value="">All Roles</option>
              @foreach (var role in Model.AvailableRoles)
              {
                <option value="@role" selected="@(Model.RoleFilter == role)">@role</option>
              }
            </select>
          </div>
          <div class="col-md-2">
            <select name="activeFilter" class="form-select">
              <option value="">All Statuses</option>
              <option value="true" selected="@(Model.ActiveFilter == true)">Active Only</option>
              <option value="false" selected="@(Model.ActiveFilter == false)">Deactivated Only</option>
            </select>
          </div>
          <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bx bx-reset"></i></a>
          </div>
        </form>
      </div>
    </div>

    <!-- Users Table Card -->
    <div class="card shadow-sm border-0">
      <div class="table-responsive text-nowrap">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>User</th>
              <th>Department</th>
              <th>Role</th>
              <th>Status</th>
              <th>Last Login</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody class="table-border-bottom-0">
            @if (Model.Users.Count == 0)
            {
              <tr>
                <td colspan="6" class="text-center py-5">
                  <div class="text-muted">
                    <i class="bx bx-user-x fs-1 d-block mb-2 text-secondary"></i>
                    <h6>No users found</h6>
                    <p class="small mb-0">Try adjusting your search criteria or add a new user.</p>
                  </div>
                </td>
              </tr>
            }
            else
            {
              @foreach (var user in Model.Users)
              {
                <tr>
                  <td>
                    <div class="d-flex align-items-center">
                      <div class="avatar avatar-sm me-3">
                        <span class="avatar-initial rounded-circle bg-label-primary font-weight-bold">
                          @(user.Name.Length > 0 ? user.Name[..1].ToUpper() : "U")
                        </span>
                      </div>
                      <div>
                        <div class="fw-semibold text-heading">@user.Name</div>
                        <small class="text-muted">@user.Email</small>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="fw-medium">@user.Department</span>
                  </td>
                  <td>
                    @{
                      var roleBadge = user.Role switch
                      {
                        "Admin" => "bg-label-danger",
                        "Manager" => "bg-label-primary",
                        "Employee" => "bg-label-info",
                        "Viewer" => "bg-label-secondary",
                        _ => "bg-label-dark"
                      };
                    }
                    <span class="badge @roleBadge">@user.Role</span>
                  </td>
                  <td>
                    @if (user.IsActive)
                    {
                      <span class="badge bg-label-success">Active</span>
                      @if (user.MustChangePassword)
                      {
                        <span class="badge bg-label-warning ms-1" title="Temporary Password Pending Change">Temp PW</span>
                      }
                    }
                    else
                    {
                      <span class="badge bg-label-danger">Deactivated</span>
                    }
                  </td>
                  <td>
                    <small class="text-muted">@(user.LastLoginAt.HasValue ? user.LastLoginAt.Value.ToString("yyyy-MM-dd HH:mm") : "Never")</small>
                  </td>
                  <td class="text-end">
                    <div class="dropdown">
                      <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                        <i class="bx bx-dots-vertical-rounded"></i>
                      </button>
                      <div class="dropdown-menu dropdown-menu-end">
                        <a class="dropdown-item" asp-action="Edit" asp-route-id="@user.Id">
                          <i class="bx bx-edit-alt me-1"></i> Edit Details
                        </a>
                        <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to @(user.IsActive ? "deactivate" : "reactivate") this user?');">
                          @Html.AntiForgeryToken()
                          <button type="submit" class="dropdown-item @(user.IsActive ? "text-danger" : "text-success")">
                            <i class="bx @(user.IsActive ? "bx-user-x" : "bx-user-check") me-1"></i>
                            @(user.IsActive ? "Deactivate Account" : "Reactivate Account")
                          </button>
                        </form>
                      </div>
                    </div>
                  </td>
                </tr>
              }
            }
          </tbody>
        </table>
      </div>

      <!-- Pagination Footer -->
      @if (Model.TotalPages > 1)
      {
        <div class="card-footer d-flex justify-content-between align-items-center py-3">
          <small class="text-muted">Showing page @Model.PageNumber of @Model.TotalPages (Total: @Model.TotalCount users)</small>
          <nav aria-label="Users pagination">
            <ul class="pagination pagination-sm mb-0">
              <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-search="@Model.Search" asp-route-roleFilter="@Model.RoleFilter" asp-route-activeFilter="@Model.ActiveFilter">Previous</a>
              </li>
              @for (int p = 1; p <= Model.TotalPages; p++)
              {
                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                  <a class="page-link" asp-action="Index" asp-route-pageNumber="@p" asp-route-search="@Model.Search" asp-route-roleFilter="@Model.RoleFilter" asp-route-activeFilter="@Model.ActiveFilter">@p</a>
                </li>
              }
              <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-search="@Model.Search" asp-route-roleFilter="@Model.RoleFilter" asp-route-activeFilter="@Model.ActiveFilter">Next</a>
              </li>
            </ul>
          </nav>
        </div>
      }
    </div>
  </div>
</div>
