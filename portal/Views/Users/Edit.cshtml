@model AspnetCoreMvcFull.ViewModels.Users.EditUserViewModel
@{
  ViewData["Title"] = "Edit User — Astra";
}

<div class="row">
  <div class="col-lg-8 col-xl-7 mx-auto">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h4 class="fw-bold mb-1"><span class="text-muted fw-light">Administration / <a asp-action="Index">Users</a> /</span> Edit User</h4>
        <p class="text-muted mb-0 small">Update user profile, department, and role assignments.</p>
      </div>
      <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bx bx-arrow-back me-1"></i> Back to Users
      </a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body p-4">
        <form asp-action="Edit" method="post">
          @Html.AntiForgeryToken()
          <input type="hidden" asp-for="Id" />
          <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

          <div class="mb-3">
            <label class="form-label">Corporate Email</label>
            <input type="text" class="form-control bg-light" value="@Model.Email" readonly disabled />
            <small class="form-text text-muted">Email address serves as corporate identity and cannot be altered.</small>
          </div>

          <div class="mb-3">
            <label class="form-label" asp-for="Name">Full Name <span class="text-danger">*</span></label>
            <input asp-for="Name" class="form-control" autofocus />
            <span asp-validation-for="Name" class="text-danger small"></span>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label" asp-for="Department">Department <span class="text-danger">*</span></label>
              <input asp-for="Department" class="form-control" />
              <span asp-validation-for="Department" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
              <label class="form-label" asp-for="Role">System Role <span class="text-danger">*</span></label>
              <select asp-for="Role" class="form-select">
                @if (ViewBag.Roles is List<string> roles)
                {
                  @foreach (var role in roles)
                  {
                    <option value="@role" selected="@(Model.Role == role)">@role</option>
                  }
                }
              </select>
              <span asp-validation-for="Role" class="text-danger small"></span>
            </div>
          </div>

          <div class="d-flex justify-content-end gap-2 pt-2 border-top">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary px-4">Save Changes</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
