@model AspnetCoreMvcFull.ViewModels.Projects.ProjectListViewModel
@{
  ViewData["Title"] = "Projects & Delivery — Astra";
  bool isManagerOrAdmin = User.IsInRole("Admin") || User.IsInRole("Manager");
}

<div class="row">
  <div class="col-12">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
      <div>
        <h4 class="fw-bold mb-1"><span class="text-muted fw-light">Projects & Delivery /</span> All Projects</h4>
        <p class="text-muted mb-0 small">Enterprise project delivery tracking, milestone health, and human capital governance.</p>
      </div>
      @if (isManagerOrAdmin)
      {
        <div>
          <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bx bx-plus-circle me-1"></i> New Project
          </a>
        </div>
      }
    </div>

    <!-- Filters Card -->
    <div class="card mb-4 shadow-sm border-0">
      <div class="card-body p-3">
        <form method="get" asp-action="Index" id="projectFilterForm">
          <div class="row g-2 mb-2">
            <!-- Search -->
            <div class="col-lg-4 col-md-6 col-12">
              <div class="input-group input-group-merge">
                <span class="input-group-text"><i class="bx bx-search"></i></span>
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by code, title, or description..." />
              </div>
            </div>

            <!-- Status -->
            <div class="col-lg-2 col-md-3 col-6">
              <select name="status" class="form-select">
                <option value="">All Statuses</option>
                <option value="NotStarted" selected="@(Model.Status == AspnetCoreMvcFull.Entities.ProjectStatus.NotStarted)">Not Started</option>
                <option value="InProgress" selected="@(Model.Status == AspnetCoreMvcFull.Entities.ProjectStatus.InProgress)">In Progress</option>
                <option value="OnHold" selected="@(Model.Status == AspnetCoreMvcFull.Entities.ProjectStatus.OnHold)">On Hold</option>
                <option value="Completed" selected="@(Model.Status == AspnetCoreMvcFull.Entities.ProjectStatus.Completed)">Completed</option>
                <option value="Cancelled" selected="@(Model.Status == AspnetCoreMvcFull.Entities.ProjectStatus.Cancelled)">Cancelled</option>
              </select>
            </div>

            <!-- Client Filter -->
            <div class="col-lg-2 col-md-3 col-6">
              <select name="clientId" class="form-select">
                <option value="">All Clients</option>
                @foreach (var c in Model.ClientOptions)
                {
                  <option value="@c.Value" selected="@(Model.ClientId?.ToString() == c.Value)">@c.Text</option>
                }
              </select>
            </div>

            <!-- Lead Filter -->
            <div class="col-lg-2 col-md-3 col-6">
              <select name="leadId" class="form-select">
                <option value="">All Leads</option>
                @foreach (var lead in Model.LeadOptions)
                {
                  <option value="@lead.Value" selected="@(Model.LeadId?.ToString() == lead.Value)">@lead.Text</option>
                }
              </select>
            </div>

            <!-- Priority -->
            <div class="col-lg-2 col-md-3 col-6">
              <select name="priority" class="form-select">
                <option value="">All Priorities</option>
                <option value="Critical" selected="@(Model.Priority == AspnetCoreMvcFull.Entities.ProjectPriority.Critical)">Critical</option>
                <option value="High" selected="@(Model.Priority == AspnetCoreMvcFull.Entities.ProjectPriority.High)">High</option>
                <option value="Medium" selected="@(Model.Priority == AspnetCoreMvcFull.Entities.ProjectPriority.Medium)">Medium</option>
                <option value="Low" selected="@(Model.Priority == AspnetCoreMvcFull.Entities.ProjectPriority.Low)">Low</option>
              </select>
            </div>
          </div>

          <!-- Secondary Filters Row -->
          <div class="row g-2 align-items-center">
            <!-- Start Date From -->
            <div class="col-lg-3 col-md-4 col-6">
              <div class="input-group input-group-sm">
                <span class="input-group-text small">Start &ge;</span>
                <input type="date" name="startDateFrom" value="@(Model.StartDateFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
              </div>
            </div>

            <!-- Planned End Before -->
            <div class="col-lg-3 col-md-4 col-6">
              <div class="input-group input-group-sm">
                <span class="input-group-text small">End &le;</span>
                <input type="date" name="plannedEndBefore" value="@(Model.PlannedEndBefore?.ToString("yyyy-MM-dd"))" class="form-control" />
              </div>
            </div>

            <!-- Archive State -->
            <div class="col-lg-2 col-md-4 col-6">
              <select name="archiveFilter" class="form-select form-select-sm">
                <option value="active" selected="@(Model.ArchiveFilter == "active")">Active Only</option>
                <option value="archived" selected="@(Model.ArchiveFilter == "archived")">Archived Only</option>
                <option value="all" selected="@(Model.ArchiveFilter == "all")">Show All</option>
              </select>
            </div>

            <!-- Sort By -->
            <div class="col-lg-2 col-md-4 col-6">
              <select name="sortBy" class="form-select form-select-sm">
                <option value="code" selected="@(Model.SortBy == "code")">Sort: Code</option>
                <option value="name" selected="@(Model.SortBy == "name")">Sort: Name</option>
                <option value="lead" selected="@(Model.SortBy == "lead")">Sort: Lead</option>
                <option value="status" selected="@(Model.SortBy == "status")">Sort: Status</option>
                <option value="priority" selected="@(Model.SortBy == "priority")">Sort: Priority</option>
                <option value="planned_end" selected="@(Model.SortBy == "planned_end")">Sort: Planned End</option>
                <option value="progress" selected="@(Model.SortBy == "progress")">Sort: Progress</option>
              </select>
            </div>

            <div class="col-lg-2 col-md-4 col-12 d-flex gap-2">
              <button type="submit" class="btn btn-sm btn-primary w-100">
                <i class="bx bx-filter-alt me-1"></i> Apply
              </button>
              <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Reset Filters"><i class="bx bx-reset"></i></a>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- Projects Table Card -->
    <div class="card shadow-sm border-0">
      <div class="table-responsive text-nowrap">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Project Code & Name</th>
              <th>Clients</th>
              <th>Project Lead</th>
              <th>Status</th>
              <th>Priority</th>
              <th>Progress</th>
              <th>Planned End</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody class="table-border-bottom-0">
            @if (Model.Projects.Count == 0)
            {
              <tr>
                <td colspan="8" class="text-center py-5">
                  <div class="text-muted">
                    <i class="bx bx-folder-open fs-1 d-block mb-2 text-secondary opacity-50"></i>
                    <h6 class="mb-1">No projects matched your criteria</h6>
                    <p class="small text-muted mb-3">Adjust your search parameters or register a new delivery initiative.</p>
                    @if (isManagerOrAdmin)
                    {
                      <a asp-action="Create" class="btn btn-sm btn-primary">
                        <i class="bx bx-plus me-1"></i> Create Project
                      </a>
                    }
                  </div>
                </td>
              </tr>
            }
            else
            {
              @foreach (var prj in Model.Projects)
              {
                <tr class="@(prj.IsArchived ? "table-light opacity-75" : "")">
                  <td>
                    <div class="d-flex flex-column">
                      <div class="d-flex align-items-center gap-1 mb-1">
                        <span class="badge bg-label-secondary font-monospace small">@prj.Code</span>
                        @if (prj.IsArchived)
                        {
                          <span class="badge bg-label-dark font-size-xs">Archived</span>
                        }
                      </div>
                      <a asp-action="Details" asp-route-id="@prj.Id" class="fw-semibold text-body">
                        @prj.Name
                      </a>
                    </div>
                  </td>
                  <td>
                    @if (prj.ClientNames.Count == 0)
                    {
                      <span class="text-muted small">Internal Project</span>
                    }
                    else if (prj.ClientNames.Count == 1)
                    {
                      <span class="small fw-semibold">@prj.ClientNames[0]</span>
                    }
                    else
                    {
                      <span class="badge bg-label-info" title="@string.Join(", ", prj.ClientNames)">
                        @prj.ClientNames[0] +@(prj.ClientNames.Count - 1) more
                      </span>
                    }
                  </td>
                  <td>
                    <div class="d-flex align-items-center">
                      <div class="avatar avatar-xs me-2">
                        <span class="avatar-initial rounded-circle bg-label-primary fw-bold font-size-xs">
                          @(prj.LeadName.Length > 0 ? prj.LeadName[0].ToString().ToUpper() : "L")
                        </span>
                      </div>
                      <div>
                        <span class="small fw-semibold d-block">@prj.LeadName</span>
                        <small class="text-muted font-size-xs">@prj.LeadEmail</small>
                      </div>
                    </div>
                  </td>
                  <td>
                    @switch (prj.Status)
                    {
                      case AspnetCoreMvcFull.Entities.ProjectStatus.NotStarted:
                        <span class="badge bg-label-secondary">Not Started</span>
                        break;
                      case AspnetCoreMvcFull.Entities.ProjectStatus.InProgress:
                        <span class="badge bg-label-primary">In Progress</span>
                        break;
                      case AspnetCoreMvcFull.Entities.ProjectStatus.OnHold:
                        <span class="badge bg-label-warning">On Hold</span>
                        break;
                      case AspnetCoreMvcFull.Entities.ProjectStatus.Completed:
                        <span class="badge bg-label-success">Completed</span>
                        break;
                      case AspnetCoreMvcFull.Entities.ProjectStatus.Cancelled:
                        <span class="badge bg-label-danger">Cancelled</span>
                        break;
                    }
                  </td>
                  <td>
                    @switch (prj.Priority)
                    {
                      case AspnetCoreMvcFull.Entities.ProjectPriority.Critical:
                        <span class="badge bg-danger">Critical</span>
                        break;
                      case AspnetCoreMvcFull.Entities.ProjectPriority.High:
                        <span class="badge bg-label-danger">High</span>
                        break;
                      case AspnetCoreMvcFull.Entities.ProjectPriority.Medium:
                        <span class="badge bg-label-info">Medium</span>
                        break;
                      case AspnetCoreMvcFull.Entities.ProjectPriority.Low:
                        <span class="badge bg-label-secondary">Low</span>
                        break;
                    }
                  </td>
                  <td style="min-width: 130px;">
                    <div class="d-flex align-items-center">
                      <div class="progress w-100 me-2" style="height: 6px;">
                        <div class="progress-bar @(prj.ProgressPercent == 100 ? "bg-success" : (prj.ProgressPercent > 50 ? "bg-primary" : "bg-warning"))" role="progressbar" style="width: @prj.ProgressPercent%"></div>
                      </div>
                      <small class="fw-semibold">@prj.ProgressPercent%</small>
                    </div>
                  </td>
                  <td>
                    <div class="d-flex flex-column">
                      <span class="small">@prj.PlannedEndDate.ToString("MMM dd, yyyy")</span>
                      @if (prj.IsOverdue)
                      {
                        <span class="badge bg-label-danger font-size-xs mt-1" title="Overdue by @prj.DaysOverdue day(s)">
                          <i class="bx bx-time-five me-1"></i> Overdue (@prj.DaysOverdue d)
                        </span>
                      }
                    </div>
                  </td>
                  <td class="text-end">
                    <div class="dropdown">
                      <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                        <i class="bx bx-dots-vertical-rounded"></i>
                      </button>
                      <div class="dropdown-menu dropdown-menu-end">
                        <a class="dropdown-item" asp-action="Details" asp-route-id="@prj.Id">
                          <i class="bx bx-show me-2"></i> View Project
                        </a>
                        @if (prj.CanEdit)
                        {
                          <a class="dropdown-item" asp-action="Edit" asp-route-id="@prj.Id">
                            <i class="bx bx-edit-alt me-2"></i> Edit Project
                          </a>
                        }
                        @if (prj.CanArchive)
                        {
                          @if (!prj.IsArchived)
                          {
                            <button type="button" class="dropdown-item text-warning" data-bs-toggle="modal" data-bs-target="#archiveModal-@prj.Id">
                              <i class="bx bx-archive me-2"></i> Archive Project
                            </button>
                          }
                          else
                          {
                            <form asp-action="Restore" asp-route-id="@prj.Id" method="post" class="d-inline">
                              @Html.AntiForgeryToken()
                              <button type="submit" class="dropdown-item text-success">
                                <i class="bx bx-archive-out me-2"></i> Restore Project
                              </button>
                            </form>
                          }
                        }
                      </div>
                    </div>

                    <!-- Archive Modal -->
                    @if (prj.CanArchive && !prj.IsArchived)
                    {
                      <div class="modal fade" id="archiveModal-@prj.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                          <div class="modal-content">
                            <div class="modal-header border-0 pb-0">
                              <h5 class="modal-title fw-bold">Archive Project</h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body text-start">
                              <p class="mb-2">Are you sure you want to archive <strong>@prj.Code — @prj.Name</strong>?</p>
                              <p class="text-muted small mb-0">Archived projects will be hidden from default views and workload calculators, but all historical data is permanently retained and restorable by the project lead or admin.</p>
                            </div>
                            <div class="modal-footer border-0 pt-0">
                              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                              <form asp-action="Archive" asp-route-id="@prj.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-warning">Confirm Archive</button>
                              </form>
                            </div>
                          </div>
                        </div>
                      </div>
                    }
                  </td>
                </tr>
              }
            }
          </tbody>
        </table>
      </div>

      <!-- Pagination Footer -->
      @if (Model.TotalPages > 1)
      {
        <div class="card-footer d-flex justify-content-between align-items-center py-3 border-top">
          <small class="text-muted">
            Showing @((Model.Page - 1) * Model.PageSize + 1) to @(Math.Min(Model.Page * Model.PageSize, Model.TotalItems)) of @Model.TotalItems projects
          </small>
          <nav aria-label="Project pagination">
            <ul class="pagination pagination-sm mb-0">
              <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.Page - 1)"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status"
                   asp-route-clientId="@Model.ClientId"
                   asp-route-leadId="@Model.LeadId"
                   asp-route-priority="@Model.Priority"
                   asp-route-startDateFrom="@(Model.StartDateFrom?.ToString("yyyy-MM-dd"))"
                   asp-route-plannedEndBefore="@(Model.PlannedEndBefore?.ToString("yyyy-MM-dd"))"
                   asp-route-archiveFilter="@Model.ArchiveFilter"
                   asp-route-sortBy="@Model.SortBy">Previous</a>
              </li>
              @for (int p = 1; p <= Model.TotalPages; p++)
              {
                <li class="page-item @(Model.Page == p ? "active" : "")">
                  <a class="page-link" asp-action="Index"
                     asp-route-page="@p"
                     asp-route-search="@Model.Search"
                     asp-route-status="@Model.Status"
                     asp-route-clientId="@Model.ClientId"
                     asp-route-leadId="@Model.LeadId"
                     asp-route-priority="@Model.Priority"
                     asp-route-startDateFrom="@(Model.StartDateFrom?.ToString("yyyy-MM-dd"))"
                     asp-route-plannedEndBefore="@(Model.PlannedEndBefore?.ToString("yyyy-MM-dd"))"
                     asp-route-archiveFilter="@Model.ArchiveFilter"
                     asp-route-sortBy="@Model.SortBy">@p</a>
                </li>
              }
              <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.Page + 1)"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status"
                   asp-route-clientId="@Model.ClientId"
                   asp-route-leadId="@Model.LeadId"
                   asp-route-priority="@Model.Priority"
                   asp-route-startDateFrom="@(Model.StartDateFrom?.ToString("yyyy-MM-dd"))"
                   asp-route-plannedEndBefore="@(Model.PlannedEndBefore?.ToString("yyyy-MM-dd"))"
                   asp-route-archiveFilter="@Model.ArchiveFilter"
                   asp-route-sortBy="@Model.SortBy">Next</a>
              </li>
            </ul>
          </nav>
        </div>
      }
    </div>
  </div>
</div>
