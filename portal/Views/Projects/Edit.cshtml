@model AspnetCoreMvcFull.ViewModels.Projects.ProjectFormViewModel
@{
  ViewData["Title"] = $"Edit Project {Model.Code} — Astra";
}

<div class="row justify-content-center">
  <div class="col-xl-9 col-lg-10 col-12">
    <!-- Breadcrumb & Header -->
    <div class="mb-4">
      <h4 class="fw-bold mb-1">
        <a asp-action="Index" class="text-muted fw-light">Projects</a> /
        <a asp-action="Details" asp-route-id="@Model.Id" class="text-muted fw-light">@Model.Code</a> / Edit
      </h4>
      <p class="text-muted mb-0 small">Update delivery parameters, milestone dates, client links, or delivery health.</p>
    </div>

    <div class="card shadow-sm border-0">
      <div class="card-body p-4">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="projectEditForm">
          @Html.AntiForgeryToken()
          <input type="hidden" asp-for="Id" />
          <input type="hidden" asp-for="RowVersion" />

          @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
          {
            <div class="alert alert-danger mb-4">
              <div asp-validation-summary="ModelOnly" class="mb-0"></div>
            </div>
          }

          <div class="row g-3">
            <!-- Project Code -->
            <div class="col-md-4 col-12">
              <label asp-for="Code" class="form-label fw-semibold">
                Project Code <span class="text-danger">*</span>
                @if (Model.IsCodeEditable)
                {
                  <span class="badge bg-label-warning ms-1 small">Admin Editable</span>
                }
              </label>
              <div class="input-group input-group-merge">
                <span class="input-group-text"><i class="bx bx-hash"></i></span>
                @if (Model.IsCodeEditable)
                {
                  <input asp-for="Code" class="form-control font-monospace" required />
                }
                else
                {
                  <input asp-for="Code" class="form-control font-monospace bg-light" readonly />
                }
              </div>
              <span asp-validation-for="Code" class="text-danger small"></span>
            </div>

            <!-- Project Name -->
            <div class="col-md-8 col-12">
              <label asp-for="Name" class="form-label fw-semibold">Project Title <span class="text-danger">*</span></label>
              <div class="input-group input-group-merge">
                <span class="input-group-text"><i class="bx bx-briefcase"></i></span>
                <input asp-for="Name" class="form-control" required autofocus />
              </div>
              <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <!-- Project Description -->
            <div class="col-12">
              <label asp-for="Description" class="form-label fw-semibold">Delivery Scope & Objectives</label>
              <textarea asp-for="Description" class="form-control" rows="3"></textarea>
              <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <!-- Project Lead -->
            <div class="col-md-6 col-12">
              <label asp-for="LeadId" class="form-label fw-semibold">Project Lead <span class="text-danger">*</span></label>
              <select asp-for="LeadId" class="form-select" asp-items="Model.LeadOptions" required>
              </select>
              <span asp-validation-for="LeadId" class="text-danger small"></span>
            </div>

            <!-- Associated Clients -->
            <div class="col-md-6 col-12">
              <label class="form-label fw-semibold">Associated Client(s)</label>
              <select asp-for="SelectedClientIds" class="form-select" asp-items="Model.ClientOptions" multiple size="3">
              </select>
              <small class="text-muted font-size-xs d-block mt-1">Hold Ctrl (Windows) / Cmd (Mac) to select multiple clients.</small>
            </div>

            <!-- Divider -->
            <div class="col-12"><hr class="my-2" /></div>

            <!-- Dates Section -->
            <div class="col-md-4 col-12">
              <label asp-for="StartDate" class="form-label fw-semibold">Start Date <span class="text-danger">*</span></label>
              <input asp-for="StartDate" type="date" class="form-control" required id="startDateInput" />
              <span asp-validation-for="StartDate" class="text-danger small"></span>
            </div>

            <div class="col-md-4 col-12">
              <label asp-for="PlannedEndDate" class="form-label fw-semibold">Planned End Date <span class="text-danger">*</span></label>
              <input asp-for="PlannedEndDate" type="date" class="form-control" required id="plannedEndDateInput" />
              <span asp-validation-for="PlannedEndDate" class="text-danger small"></span>
            </div>

            <div class="col-md-4 col-12">
              <label asp-for="ActualEndDate" class="form-label fw-semibold">Actual End Date</label>
              <input asp-for="ActualEndDate" type="date" class="form-control" id="actualEndDateInput" />
              <small class="text-muted font-size-xs d-block">Required when Completed or Cancelled.</small>
              <span asp-validation-for="ActualEndDate" class="text-danger small"></span>
            </div>

            <!-- Divider -->
            <div class="col-12"><hr class="my-2" /></div>

            <!-- Status, Priority, Progress -->
            <div class="col-md-3 col-6">
              <label asp-for="Status" class="form-label fw-semibold">Status <span class="text-danger">*</span></label>
              <select asp-for="Status" class="form-select" id="statusSelect">
                <option value="NotStarted">Not Started</option>
                <option value="InProgress">In Progress</option>
                <option value="OnHold">On Hold</option>
                <option value="Completed">Completed</option>
                <option value="Cancelled">Cancelled</option>
              </select>
              <span asp-validation-for="Status" class="text-danger small"></span>
            </div>

            <div class="col-md-3 col-6">
              <label asp-for="Priority" class="form-label fw-semibold">Priority <span class="text-danger">*</span></label>
              <select asp-for="Priority" class="form-select">
                <option value="Low">Low</option>
                <option value="Medium">Medium</option>
                <option value="High">High</option>
                <option value="Critical">Critical</option>
              </select>
              <span asp-validation-for="Priority" class="text-danger small"></span>
            </div>

            <div class="col-md-3 col-6">
              <label asp-for="ProgressMode" class="form-label fw-semibold">Progress Mode</label>
              <select asp-for="ProgressMode" class="form-select">
                <option value="Manual">Manual</option>
                <option value="Derived">Derived (Tasks/Milestones)</option>
              </select>
              <span asp-validation-for="ProgressMode" class="text-danger small"></span>
            </div>

            <div class="col-md-3 col-6">
              <label asp-for="ProgressPercent" class="form-label fw-semibold">Progress (%)</label>
              <div class="input-group">
                <input asp-for="ProgressPercent" type="number" min="0" max="100" class="form-control" id="progressPercentInput" />
                <span class="input-group-text">%</span>
              </div>
              <span asp-validation-for="ProgressPercent" class="text-danger small"></span>
            </div>

            <!-- Form Actions -->
            <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
              <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                <i class="bx bx-arrow-back me-1"></i> Cancel
              </a>
              <button type="submit" class="btn btn-primary">
                <i class="bx bx-save me-1"></i> Save Changes
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

@section PageScripts {
  <partial name="_ValidationScriptsPartial" />
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const statusSelect = document.getElementById('statusSelect');
      const progressInput = document.getElementById('progressPercentInput');
      const actualEndInput = document.getElementById('actualEndDateInput');

      statusSelect.addEventListener('change', function () {
        const val = statusSelect.value;
        const todayStr = new Date().toISOString().split('T')[0];

        if (val === 'Completed') {
          if (parseInt(progressInput.value) < 100) {
            progressInput.value = 100;
          }
          if (!actualEndInput.value) {
            actualEndInput.value = todayStr;
          }
        } else if (val === 'Cancelled') {
          if (!actualEndInput.value) {
            actualEndInput.value = todayStr;
          }
        }
      });
    });
  </script>
}
