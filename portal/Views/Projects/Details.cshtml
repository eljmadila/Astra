@model AspnetCoreMvcFull.ViewModels.Projects.ProjectDetailsViewModel
@{
  ViewData["Title"] = $"{Model.Project.Code} — {Model.Project.Name}";
  var today = DateOnly.FromDateTime(DateTime.UtcNow);
  var isOverdue = Model.Project.Status != AspnetCoreMvcFull.Entities.ProjectStatus.Completed &&
                  Model.Project.Status != AspnetCoreMvcFull.Entities.ProjectStatus.Cancelled &&
                  Model.Project.PlannedEndDate < today;
  var daysOverdue = isOverdue ? (today.DayNumber - Model.Project.PlannedEndDate.DayNumber) : 0;
}

<div class="row">
  <!-- Top Bar / Breadcrumb & Actions -->
  <div class="col-12 mb-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div>
        <h4 class="fw-bold mb-1">
          <a asp-action="Index" class="text-muted fw-light">Projects</a> /
          <span class="font-monospace text-primary">@Model.Project.Code</span>
        </h4>
        <h5 class="fw-semibold text-secondary mb-0">@Model.Project.Name</h5>
      </div>
      <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
          <i class="bx bx-arrow-back me-1"></i> Back to List
        </a>
        @if (Model.CanEdit)
        {
          <a asp-action="Edit" asp-route-id="@Model.Project.Id" class="btn btn-primary">
            <i class="bx bx-edit me-1"></i> Edit Project
          </a>
        }
        @if (Model.CanArchive)
        {
          @if (!Model.Project.IsArchived)
          {
            <button type="button" class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#detailArchiveModal">
              <i class="bx bx-archive me-1"></i> Archive
            </button>
          }
          else
          {
            <form asp-action="Restore" asp-route-id="@Model.Project.Id" method="post" class="d-inline">
              @Html.AntiForgeryToken()
              <button type="submit" class="btn btn-outline-success">
                <i class="bx bx-archive-out me-1"></i> Restore
              </button>
            </form>
          }
        }
      </div>
    </div>
  </div>

  @if (Model.Project.IsArchived)
  {
    <div class="col-12 mb-3">
      <div class="alert alert-dark d-flex align-items-center mb-0" role="alert">
        <i class="bx bx-archive fs-4 me-2"></i>
        <div>This project is currently <strong>archived</strong>. It is excluded from active workload dashboards.</div>
      </div>
    </div>
  }

  <!-- Tabbed Shell -->
  <div class="col-12">
    <div class="nav-align-top mb-4">
      <ul class="nav nav-tabs nav-fill" role="tablist">
        <li class="nav-item">
          <button type="button" class="nav-link active fw-semibold" role="tab" data-bs-toggle="tab" data-bs-target="#navs-overview">
            <i class="bx bx-detail me-1"></i> Overview & Governance
          </button>
        </li>
        <li class="nav-item">
          <button type="button" class="nav-link disabled" role="tab" tabindex="-1">
            <i class="bx bx-group me-1"></i> Team Staffing
            <span class="badge bg-label-secondary font-size-xs ms-1">Week 3</span>
          </button>
        </li>
        <li class="nav-item">
          <button type="button" class="nav-link disabled" role="tab" tabindex="-1">
            <i class="bx bx-check-square me-1"></i> Task Board
            <span class="badge bg-label-secondary font-size-xs ms-1">Week 5</span>
          </button>
        </li>
        <li class="nav-item">
          <button type="button" class="nav-link disabled" role="tab" tabindex="-1">
            <i class="bx bx-line-chart me-1"></i> Progress Log
            <span class="badge bg-label-secondary font-size-xs ms-1">Week 5</span>
          </button>
        </li>
        <li class="nav-item">
          <button type="button" class="nav-link disabled" role="tab" tabindex="-1">
            <i class="bx bx-transfer-alt me-1"></i> Reassignments
            <span class="badge bg-label-secondary font-size-xs ms-1">Week 4</span>
          </button>
        </li>
      </ul>

      <div class="tab-content bg-transparent p-0 pt-3">
        <!-- Overview Tab -->
        <div class="tab-pane fade show active" id="navs-overview" role="tabpanel">
          <div class="row">
            <!-- Left Column: Metrics & Scope -->
            <div class="col-lg-8 col-12">
              <!-- Summary Card -->
              <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                  <h6 class="text-uppercase text-muted fw-bold mb-3">Project Status & Delivery Health</h6>
                  <div class="d-flex align-items-center flex-wrap gap-3 mb-4">
                    <div>
                      <span class="text-muted small d-block mb-1">Status</span>
                      @switch (Model.Project.Status)
                      {
                        case AspnetCoreMvcFull.Entities.ProjectStatus.NotStarted:
                          <span class="badge bg-label-secondary fs-6">Not Started</span>
                          break;
                        case AspnetCoreMvcFull.Entities.ProjectStatus.InProgress:
                          <span class="badge bg-label-primary fs-6">In Progress</span>
                          break;
                        case AspnetCoreMvcFull.Entities.ProjectStatus.OnHold:
                          <span class="badge bg-label-warning fs-6">On Hold</span>
                          break;
                        case AspnetCoreMvcFull.Entities.ProjectStatus.Completed:
                          <span class="badge bg-label-success fs-6">Completed</span>
                          break;
                        case AspnetCoreMvcFull.Entities.ProjectStatus.Cancelled:
                          <span class="badge bg-label-danger fs-6">Cancelled</span>
                          break;
                      }
                    </div>

                    <div>
                      <span class="text-muted small d-block mb-1">Priority</span>
                      @switch (Model.Project.Priority)
                      {
                        case AspnetCoreMvcFull.Entities.ProjectPriority.Critical:
                          <span class="badge bg-danger fs-6">Critical</span>
                          break;
                        case AspnetCoreMvcFull.Entities.ProjectPriority.High:
                          <span class="badge bg-label-danger fs-6">High</span>
                          break;
                        case AspnetCoreMvcFull.Entities.ProjectPriority.Medium:
                          <span class="badge bg-label-info fs-6">Medium</span>
                          break;
                        case AspnetCoreMvcFull.Entities.ProjectPriority.Low:
                          <span class="badge bg-label-secondary fs-6">Low</span>
                          break;
                      }
                    </div>

                    <div>
                      <span class="text-muted small d-block mb-1">Calculation Mode</span>
                      <span class="badge bg-label-info fs-6">
                        @(Model.Project.ProgressMode == AspnetCoreMvcFull.Entities.ProgressMode.Manual ? "Manual Mode" : "Derived Mode")
                      </span>
                    </div>

                    @if (isOverdue)
                    {
                      <div>
                        <span class="text-muted small d-block mb-1">Schedule Flag</span>
                        <span class="badge bg-danger fs-6">
                          <i class="bx bx-time-five me-1"></i> Overdue by @daysOverdue day(s)
                        </span>
                      </div>
                    }
                  </div>

                  <!-- Progress Bar -->
                  <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <span class="fw-semibold text-secondary">Overall Delivery Progress</span>
                      <span class="fw-bold fs-6">@Model.Project.ProgressPercent%</span>
                    </div>
                    <div class="progress" style="height: 10px;">
                      <div class="progress-bar @(Model.Project.ProgressPercent == 100 ? "bg-success" : (Model.Project.ProgressPercent > 50 ? "bg-primary" : "bg-warning"))"
                           role="progressbar" style="width: @Model.Project.ProgressPercent%" aria-valuenow="@Model.Project.ProgressPercent" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                  </div>

                  <!-- Scope Description -->
                  <h6 class="text-uppercase text-muted fw-bold mb-2">Scope & Description</h6>
                  <p class="text-secondary mb-0">
                    @(string.IsNullOrWhiteSpace(Model.Project.Description) ? "No detailed project scope description provided." : Model.Project.Description)
                  </p>
                </div>
              </div>

              <!-- Audit Trail Card -->
              <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
                  <h6 class="mb-0 fw-bold">Recent Governance Activity</h6>
                  <span class="badge bg-label-secondary font-size-xs">Append-Only Audit Stream</span>
                </div>
                <div class="card-body p-0">
                  <div class="table-responsive text-nowrap">
                    <table class="table table-sm table-hover mb-0">
                      <thead class="table-light">
                        <tr>
                          <th>Action</th>
                          <th>Operator</th>
                          <th>Timestamp</th>
                          <th>Details</th>
                        </tr>
                      </thead>
                      <tbody>
                        @if (Model.RecentAuditLogs.Count == 0)
                        {
                          <tr>
                            <td colspan="4" class="text-center py-4 text-muted small">No audit log records recorded yet.</td>
                          </tr>
                        }
                        else
                        {
                          @foreach (var log in Model.RecentAuditLogs)
                          {
                            <tr>
                              <td>
                                <span class="badge bg-label-primary">@log.Action</span>
                              </td>
                              <td class="small">@(log.User?.Name ?? "System")</td>
                              <td class="small text-muted">@log.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                              <td class="small text-truncate" style="max-width: 300px;">
                                <code class="font-size-xs">@log.Details</code>
                              </td>
                            </tr>
                          }
                        }
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <!-- Right Column: Lead, Clients, Dates -->
            <div class="col-lg-4 col-12">
              <!-- Lead Card -->
              <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light py-2">
                  <h6 class="mb-0 fw-bold small text-uppercase text-muted">Project Leadership</h6>
                </div>
                <div class="card-body pt-3">
                  <div class="d-flex align-items-center">
                    <div class="avatar avatar-md me-3">
                      <span class="avatar-initial rounded-circle bg-label-primary fw-bold fs-5">
                        @(Model.Project.Lead != null && Model.Project.Lead.Name.Length > 0 ? Model.Project.Lead.Name[0].ToString().ToUpper() : "L")
                      </span>
                    </div>
                    <div>
                      <h6 class="mb-0 fw-bold">@(Model.Project.Lead?.Name ?? "Unassigned")</h6>
                      <small class="text-muted d-block">@(Model.Project.Lead?.Email ?? "")</small>
                      <span class="badge bg-label-info font-size-xs mt-1">@(Model.Project.Lead?.Department ?? "Executive")</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Associated Clients Card -->
              <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light py-2">
                  <h6 class="mb-0 fw-bold small text-uppercase text-muted">Associated Stakeholder Clients</h6>
                </div>
                <div class="card-body pt-3">
                  @if (Model.Project.ProjectClients.Count == 0)
                  {
                    <p class="text-muted small mb-0">Internal engagement (no external client linkage).</p>
                  }
                  else
                  {
                    <ul class="list-group list-group-flush">
                      @foreach (var pc in Model.Project.ProjectClients)
                      {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                          <div>
                            <a asp-controller="Clients" asp-action="Details" asp-route-id="@pc.ClientId" class="fw-semibold text-body">
                              @pc.Client.Name
                            </a>
                            <small class="text-muted d-block font-size-xs">@pc.Client.ContactPerson</small>
                          </div>
                          <a asp-controller="Clients" asp-action="Details" asp-route-id="@pc.ClientId" class="btn btn-sm btn-icon btn-outline-primary">
                            <i class="bx bx-chevron-right"></i>
                          </a>
                        </li>
                      }
                    </ul>
                  }
                </div>
              </div>

              <!-- Timeline Schedule Card -->
              <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light py-2">
                  <h6 class="mb-0 fw-bold small text-uppercase text-muted">Schedule & Milestones</h6>
                </div>
                <div class="card-body pt-3">
                  <ul class="list-unstyled mb-0">
                    <li class="d-flex justify-content-between mb-2">
                      <span class="text-muted small">Start Date:</span>
                      <span class="fw-semibold small">@Model.Project.StartDate.ToString("MMM dd, yyyy")</span>
                    </li>
                    <li class="d-flex justify-content-between mb-2">
                      <span class="text-muted small">Planned End Date:</span>
                      <span class="fw-semibold small @(isOverdue ? "text-danger" : "")">
                        @Model.Project.PlannedEndDate.ToString("MMM dd, yyyy")
                      </span>
                    </li>
                    <li class="d-flex justify-content-between mb-2">
                      <span class="text-muted small">Actual End Date:</span>
                      <span class="fw-semibold small">
                        @(Model.Project.ActualEndDate.HasValue ? Model.Project.ActualEndDate.Value.ToString("MMM dd, yyyy") : "In Flight")
                      </span>
                    </li>
                    <li class="d-flex justify-content-between pt-2 border-top">
                      <span class="text-muted small">Created:</span>
                      <span class="small text-muted">@Model.Project.CreatedAt.ToString("MMM dd, yyyy")</span>
                    </li>
                    <li class="d-flex justify-content-between">
                      <span class="text-muted small">Last Modified:</span>
                      <span class="small text-muted">@Model.Project.UpdatedAt.ToString("MMM dd, yyyy")</span>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Archive Modal -->
@if (Model.CanArchive && !Model.Project.IsArchived)
{
  <div class="modal fade" id="detailArchiveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold">Archive Project</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-start">
          <p class="mb-2">Are you sure you want to archive <strong>@Model.Project.Code — @Model.Project.Name</strong>?</p>
          <p class="text-muted small mb-0">Archived projects are hidden from default views. All history is retained and can be restored at any time.</p>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <form asp-action="Archive" asp-route-id="@Model.Project.Id" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-warning">Confirm Archive</button>
          </form>
        </div>
      </div>
    </div>
  </div>
}
