@model AspnetCoreMvcFull.ViewModels.ProjectRoles.ProjectRoleListViewModel
@{
  ViewData["Title"] = "Project Roles — Astra Admin";
}

<div class="row">
  <div class="col-12">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
      <div>
        <h4 class="fw-bold mb-1"><span class="text-muted fw-light">Administration /</span> Project Roles</h4>
        <p class="text-muted mb-0 small">Configurable lookup roles for team assignments and project responsibilities.</p>
      </div>
      <div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addRoleModal">
          <i class="bx bx-plus me-1"></i> Add Project Role
        </button>
      </div>
    </div>

    <!-- Project Roles Card -->
    <div class="card shadow-sm border-0">
      <div class="table-responsive text-nowrap">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Role Name</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody class="table-border-bottom-0">
            @if (Model.Roles.Count == 0)
            {
              <tr>
                <td colspan="3" class="text-center py-5 text-muted">
                  <i class="bx bx-badge-check fs-1 d-block mb-2 text-secondary opacity-50"></i>
                  <h6>No project roles configured</h6>
                </td>
              </tr>
            }
            else
            {
              @foreach (var role in Model.Roles)
              {
                <tr>
                  <td>
                    <div class="d-flex align-items-center">
                      <span class="badge rounded-pill bg-label-primary p-2 me-3">
                        <i class="bx bx-user-check"></i>
                      </span>
                      <span class="fw-semibold text-body fs-6">@role.Name</span>
                    </div>
                  </td>
                  <td>
                    @if (role.IsActive)
                    {
                      <span class="badge bg-label-success">Active</span>
                    }
                    else
                    {
                      <span class="badge bg-label-secondary">Deactivated</span>
                    }
                  </td>
                  <td class="text-end">
                    <button type="button" class="btn btn-sm btn-outline-primary me-2" data-bs-toggle="modal" data-bs-target="#renameRoleModal-@role.Id">
                      <i class="bx bx-edit-alt me-1"></i> Rename
                    </button>
                    <form asp-action="ToggleStatus" asp-route-id="@role.Id" method="post" class="d-inline">
                      @Html.AntiForgeryToken()
                      <button type="submit" class="btn btn-sm btn-outline-@(role.IsActive ? "warning" : "success")">
                        <i class="bx bx-power-off me-1"></i> @(role.IsActive ? "Deactivate" : "Activate")
                      </button>
                    </form>

                    <!-- Rename Modal -->
                    <div class="modal fade" id="renameRoleModal-@role.Id" tabindex="-1" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                          <form asp-action="Rename" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@role.Id" />
                            <div class="modal-header">
                              <h5 class="modal-title fw-bold">Rename Role</h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body text-start">
                              <label class="form-label fw-semibold">Role Name <span class="text-danger">*</span></label>
                              <input type="text" name="name" value="@role.Name" class="form-control" required />
                            </div>
                            <div class="modal-footer">
                              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                              <button type="submit" class="btn btn-primary">Save Changes</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>
                  </td>
                </tr>
              }
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Add Role Modal -->
<div class="modal fade" id="addRoleModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="modal-header">
          <h5 class="modal-title fw-bold">Add Project Role</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label asp-for="NewRoleForm.Name" class="form-label fw-semibold">Role Name <span class="text-danger">*</span></label>
            <input asp-for="NewRoleForm.Name" class="form-control" placeholder="e.g. Solution Architect" required />
            <span asp-validation-for="NewRoleForm.Name" class="text-danger small"></span>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Create Role</button>
        </div>
      </form>
    </div>
  </div>
</div>
