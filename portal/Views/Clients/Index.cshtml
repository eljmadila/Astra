@model AspnetCoreMvcFull.ViewModels.Clients.ClientListViewModel
@{
  ViewData["Title"] = "Client Directory — Astra";
  bool isManagerOrAdmin = User.IsInRole("Admin") || User.IsInRole("Manager");
}

<div class="row">
  <div class="col-12">
    <!-- Header Card -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
      <div>
        <h4 class="fw-bold mb-1"><span class="text-muted fw-light">Portfolio /</span> Client Directory</h4>
        <p class="text-muted mb-0 small">Client stakeholders, enterprise partners, and project linkages across Astra.</p>
      </div>
      @if (isManagerOrAdmin)
      {
        <div>
          <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bx bx-plus-circle me-1"></i> Add New Client
          </a>
        </div>
      }
    </div>

    <!-- Filters & Search Card -->
    <div class="card mb-4 shadow-sm border-0">
      <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
          <div class="col-md-5">
            <div class="input-group input-group-merge">
              <span class="input-group-text"><i class="bx bx-search"></i></span>
              <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search client name, contact, email, phone..." />
            </div>
          </div>
          <div class="col-md-3">
            <select name="statusFilter" class="form-select">
              <option value="all" selected="@(Model.StatusFilter == "all")">All Statuses</option>
              <option value="active" selected="@(Model.StatusFilter == "active")">Active Clients Only</option>
              <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Deactivated Clients Only</option>
            </select>
          </div>
          <div class="col-md-2">
            <select name="sortBy" class="form-select">
              <option value="name" selected="@(Model.SortBy == "name")">Sort by Name</option>
              <option value="contact" selected="@(Model.SortBy == "contact")">Sort by Contact</option>
              <option value="email" selected="@(Model.SortBy == "email")">Sort by Email</option>
              <option value="projects" selected="@(Model.SortBy == "projects")">Sort by Projects</option>
              <option value="created" selected="@(Model.SortBy == "created")">Sort by Date Added</option>
            </select>
          </div>
          <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">
              <i class="bx bx-filter-alt me-1"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bx bx-reset"></i></a>
          </div>
        </form>
      </div>
    </div>

    <!-- Clients Table Card -->
    <div class="card shadow-sm border-0">
      <div class="table-responsive text-nowrap">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Client Name</th>
              <th>Contact Person</th>
              <th>Email & Phone</th>
              <th>Projects</th>
              <th>Status</th>
              <th>Added</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody class="table-border-bottom-0">
            @if (Model.Clients.Count == 0)
            {
              <tr>
                <td colspan="7" class="text-center py-5">
                  <div class="text-muted">
                    <i class="bx bx-buildings fs-1 d-block mb-2 text-secondary opacity-50"></i>
                    <h6 class="mb-1">No clients found</h6>
                    <p class="small text-muted mb-3">Adjust your search filters or register a new client partnership.</p>
                    @if (isManagerOrAdmin)
                    {
                      <a asp-action="Create" class="btn btn-sm btn-outline-primary">
                        <i class="bx bx-plus me-1"></i> Add Client
                      </a>
                    }
                  </div>
                </td>
              </tr>
            }
            else
            {
              @foreach (var client in Model.Clients)
              {
                <tr>
                  <td>
                    <div class="d-flex align-items-center">
                      <div class="avatar avatar-sm me-3 flex-shrink-0">
                        <span class="avatar-initial rounded-circle bg-label-primary fw-semibold">
                          @(client.Name.Length > 0 ? client.Name[0].ToString().ToUpper() : "C")
                        </span>
                      </div>
                      <div>
                        <a asp-action="Details" asp-route-id="@client.Id" class="fw-semibold text-body d-block">
                          @client.Name
                        </a>
                      </div>
                    </div>
                  </td>
                  <td>
                    @(string.IsNullOrWhiteSpace(client.ContactPerson) ? "—" : client.ContactPerson)
                  </td>
                  <td>
                    @if (!string.IsNullOrWhiteSpace(client.Email))
                    {
                      <div class="d-flex align-items-center mb-1">
                        <i class="bx bx-envelope text-muted me-1 small"></i>
                        <a href="mailto:@client.Email" class="text-muted small text-truncate" style="max-width: 180px;">@client.Email</a>
                      </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(client.Phone))
                    {
                      <div class="d-flex align-items-center">
                        <i class="bx bx-phone text-muted me-1 small"></i>
                        <span class="text-muted small">@client.Phone</span>
                      </div>
                    }
                    @if (string.IsNullOrWhiteSpace(client.Email) && string.IsNullOrWhiteSpace(client.Phone))
                    {
                      <span class="text-muted">—</span>
                    }
                  </td>
                  <td>
                    <span class="badge bg-label-info">
                      @client.ActiveProjectsCount active / @client.TotalProjectsCount total
                    </span>
                  </td>
                  <td>
                    @if (client.IsActive)
                    {
                      <span class="badge bg-label-success">Active</span>
                    }
                    else
                    {
                      <span class="badge bg-label-danger">Deactivated</span>
                    }
                  </td>
                  <td>
                    <span class="text-muted small">@client.CreatedAt.ToString("MMM dd, yyyy")</span>
                  </td>
                  <td class="text-end">
                    <div class="dropdown">
                      <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                        <i class="bx bx-dots-vertical-rounded"></i>
                      </button>
                      <div class="dropdown-menu dropdown-menu-end">
                        <a class="dropdown-item" asp-action="Details" asp-route-id="@client.Id">
                          <i class="bx bx-show me-2"></i> View Details
                        </a>
                        @if (isManagerOrAdmin)
                        {
                          <a class="dropdown-item" asp-action="Edit" asp-route-id="@client.Id">
                            <i class="bx bx-edit-alt me-2"></i> Edit Client
                          </a>
                          <form asp-action="ToggleStatus" asp-route-id="@client.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-@(client.IsActive ? "warning" : "success")">
                              <i class="bx bx-power-off me-2"></i> @(client.IsActive ? "Deactivate" : "Reactivate")
                            </button>
                          </form>
                          <div class="dropdown-divider"></div>
                          <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deleteClientModal-@client.Id">
                            <i class="bx bx-trash me-2"></i> Delete / Deactivate
                          </button>
                        }
                      </div>
                    </div>

                    <!-- Delete Confirmation Modal -->
                    @if (isManagerOrAdmin)
                    {
                      <div class="modal fade" id="deleteClientModal-@client.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                          <div class="modal-content">
                            <div class="modal-header border-0 pb-0">
                              <h5 class="modal-title fw-bold">Delete Client</h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body text-start">
                              <p class="mb-2">Are you sure you want to remove client <strong>@client.Name</strong>?</p>
                              @if (client.TotalProjectsCount > 0)
                              {
                                <div class="alert alert-warning py-2 mb-0 small">
                                  <i class="bx bx-info-circle me-1"></i>
                                  This client is associated with <strong>@client.TotalProjectsCount project(s)</strong>.
                                  To maintain audit integrity and historical continuity, deleting will <strong>deactivate</strong> the client instead of hard deleting.
                                </div>
                              }
                              else
                              {
                                <p class="text-muted small mb-0">This client has no linked projects and will be permanently deleted.</p>
                              }
                            </div>
                            <div class="modal-footer border-0 pt-0">
                              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                              <form asp-action="Delete" asp-route-id="@client.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger">Confirm</button>
                              </form>
                            </div>
                          </div>
                        </div>
                      </div>
                    }
                  </td>
                </tr>
              }
            }
          </tbody>
        </table>
      </div>

      <!-- Pagination Footer -->
      @if (Model.TotalPages > 1)
      {
        <div class="card-footer d-flex justify-content-between align-items-center py-3 border-top">
          <small class="text-muted">
            Showing @((Model.Page - 1) * Model.PageSize + 1) to @(Math.Min(Model.Page * Model.PageSize, Model.TotalItems)) of @Model.TotalItems clients
          </small>
          <nav aria-label="Client navigation">
            <ul class="pagination pagination-sm mb-0">
              <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.Page - 1)"
                   asp-route-search="@Model.Search"
                   asp-route-statusFilter="@Model.StatusFilter"
                   asp-route-sortBy="@Model.SortBy">Previous</a>
              </li>
              @for (int p = 1; p <= Model.TotalPages; p++)
              {
                <li class="page-item @(Model.Page == p ? "active" : "")">
                  <a class="page-link" asp-action="Index"
                     asp-route-page="@p"
                     asp-route-search="@Model.Search"
                     asp-route-statusFilter="@Model.StatusFilter"
                     asp-route-sortBy="@Model.SortBy">@p</a>
                </li>
              }
              <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.Page + 1)"
                   asp-route-search="@Model.Search"
                   asp-route-statusFilter="@Model.StatusFilter"
                   asp-route-sortBy="@Model.SortBy">Next</a>
              </li>
            </ul>
          </nav>
        </div>
      }
    </div>
  </div>
</div>
