@{
  Layout = "_BlankLayout";
  ViewData["Title"] = "Sign In — Astra";
}

@section PageStyles {
<link rel="stylesheet" href="~/vendor/css/pages/page-auth.css" />
}

@* ************** Content ************** *@
<div class="container-xxl">
  <div class="authentication-wrapper authentication-basic container-p-y">
    <div class="authentication-inner">
      <div class="card px-sm-6 px-0 shadow-sm border-0">
        <div class="card-body">
          <!-- Logo & Brand -->
          <div class="app-brand justify-content-center mb-4">
            <a asp-controller="Dashboards" asp-action="Index" class="app-brand-link gap-2">
              <span class="app-brand-logo demo">@await Html.PartialAsync("../_Partials/_Macros")</span>
              <span class="app-brand-text demo text-heading fw-bold fs-4">@TempData.Peek("appName")</span>
            </a>
          </div>
          <!-- /Logo -->

          <h4 class="mb-1 text-center">Welcome Back! 👋</h4>
          <p class="mb-4 text-center text-muted small">Sign in with your corporate credentials to access projects and staff allocations.</p>

          <!-- Toast / Flash messages if any -->
          @await Html.PartialAsync("_ToastMessages")

          <form id="formAuthentication" class="mb-4" asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
              <label for="email" class="form-label">Email Address</label>
              <input type="email" class="form-control" id="email" name="Email" placeholder="employee@company.com" required autofocus />
            </div>

            <div class="mb-3 form-password-toggle">
              <div class="d-flex justify-content-between">
                <label class="form-label" for="password">Password</label>
                <a asp-controller="Auth" asp-action="ForgotPassword" class="small">
                  <span>Forgot Password?</span>
                </a>
              </div>
              <div class="input-group input-group-merge">
                <input type="password" id="password" class="form-control" name="Password" placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;" aria-describedby="password" required />
                <span class="input-group-text cursor-pointer"><i class="icon-base bx bx-hide"></i></span>
              </div>
            </div>

            <div class="mb-4">
              <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="remember-me" name="RememberMe" value="true" />
                <label class="form-check-label small" for="remember-me"> Keep me signed in </label>
              </div>
            </div>

            <div class="mb-3">
              <button class="btn btn-primary d-grid w-100 py-2" type="submit">Sign In</button>
            </div>
          </form>

          <div class="text-center text-muted small">
            <span>Account access is managed centrally. Need access? Contact your </span>
            <span class="fw-semibold">Portal Administrator</span>.
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
