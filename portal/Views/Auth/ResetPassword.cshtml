@model AspnetCoreMvcFull.ViewModels.Auth.ResetPasswordViewModel
@{
  Layout = "_BlankLayout";
  ViewData["Title"] = "Reset Password — Astra";
}

@section PageStyles {
<link rel="stylesheet" href="~/vendor/css/pages/page-auth.css" />
}

<div class="container-xxl">
  <div class="authentication-wrapper authentication-basic container-p-y">
    <div class="authentication-inner">
      <div class="card px-sm-6 px-0 shadow-sm border-0">
        <div class="card-body">
          <div class="app-brand justify-content-center mb-4">
            <a href="/" class="app-brand-link gap-2">
              <span class="app-brand-logo demo">@await Html.PartialAsync("../_Partials/_Macros")</span>
              <span class="app-brand-text demo text-heading fw-bold fs-4">@TempData.Peek("appName")</span>
            </a>
          </div>

          <h4 class="mb-1 text-center">Reset Password 🔑</h4>
          <p class="mb-4 text-center text-muted small">Enter your new secure password for <strong>@Model.Email</strong>.</p>

          <form asp-controller="Auth" asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3 form-password-toggle">
              <label class="form-label" asp-for="Password">New Password</label>
              <div class="input-group input-group-merge">
                <input asp-for="Password" class="form-control" placeholder="Minimum 12 characters" required autofocus />
                <span class="input-group-text cursor-pointer"><i class="icon-base bx bx-hide"></i></span>
              </div>
              <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4 form-password-toggle">
              <label class="form-label" asp-for="ConfirmPassword">Confirm Password</label>
              <div class="input-group input-group-merge">
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter password" required />
                <span class="input-group-text cursor-pointer"><i class="icon-base bx bx-hide"></i></span>
              </div>
              <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button class="btn btn-primary d-grid w-100 py-2 mb-3" type="submit">Set New Password</button>

            <div class="text-center">
              <a asp-controller="Auth" asp-action="Login" class="d-flex align-items-center justify-content-center small">
                <i class="bx bx-chevron-left scaleX-n1-rtl bx-sm"></i> Back to login
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
