@model AspnetCoreMvcFull.ViewModels.Auth.ChangePasswordViewModel
@{
  Layout = Model.IsForced ? "_BlankLayout" : "_ContentNavbarLayout";
  ViewData["Title"] = "Change Password — Astra";
}

@section PageStyles {
  @if (Model.IsForced)
  {
    <link rel="stylesheet" href="~/vendor/css/pages/page-auth.css" />
  }
}

@if (Model.IsForced)
{
  <div class="container-xxl">
    <div class="authentication-wrapper authentication-basic container-p-y">
      <div class="authentication-inner">
        <div class="card px-sm-6 px-0 shadow-sm border-0">
          <div class="card-body">
            <!-- Logo -->
            <div class="app-brand justify-content-center mb-4">
              <a href="/" class="app-brand-link gap-2">
                <span class="app-brand-logo demo">@await Html.PartialAsync("../_Partials/_Macros")</span>
                <span class="app-brand-text demo text-heading fw-bold fs-4">@TempData.Peek("appName")</span>
              </a>
            </div>
            <!-- /Logo -->

            <h4 class="mb-1 text-center">Set Your New Password 🔒</h4>
            <p class="mb-4 text-center text-muted small">You are currently using a temporary password. Please set a permanent password (min 12 characters) to continue.</p>

            <form asp-controller="Auth" asp-action="ChangePassword" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
              @Html.AntiForgeryToken()
              <input type="hidden" asp-for="IsForced" />
              <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

              <div class="mb-3 form-password-toggle">
                <label class="form-label" asp-for="CurrentPassword"></label>
                <div class="input-group input-group-merge">
                  <input asp-for="CurrentPassword" class="form-control" placeholder="Current temporary password" />
                  <span class="input-group-text cursor-pointer"><i class="icon-base bx bx-hide"></i></span>
                </div>
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
              </div>

              <div class="mb-3 form-password-toggle">
                <label class="form-label" asp-for="NewPassword"></label>
                <div class="input-group input-group-merge">
                  <input asp-for="NewPassword" class="form-control" placeholder="At least 12 characters" />
                  <span class="input-group-text cursor-pointer"><i class="icon-base bx bx-hide"></i></span>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
              </div>

              <div class="mb-4 form-password-toggle">
                <label class="form-label" asp-for="ConfirmPassword"></label>
                <div class="input-group input-group-merge">
                  <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter new password" />
                  <span class="input-group-text cursor-pointer"><i class="icon-base bx bx-hide"></i></span>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
              </div>

              <button class="btn btn-primary d-grid w-100 py-2" type="submit">Update Password & Access Portal</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
}
else
{
  <div class="row">
    <div class="col-md-6 col-lg-5 mx-auto">
      <div class="card mb-4 shadow-sm border-0">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Change Account Password</h5>
          <small class="text-muted">Security Center</small>
        </div>
        <div class="card-body">
          <form asp-controller="Auth" asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3 form-password-toggle">
              <label class="form-label" asp-for="CurrentPassword"></label>
              <div class="input-group input-group-merge">
                <input asp-for="CurrentPassword" class="form-control" />
                <span class="input-group-text cursor-pointer"><i class="icon-base bx bx-hide"></i></span>
              </div>
              <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3 form-password-toggle">
              <label class="form-label" asp-for="NewPassword"></label>
              <div class="input-group input-group-merge">
                <input asp-for="NewPassword" class="form-control" placeholder="Min 12 characters" />
                <span class="input-group-text cursor-pointer"><i class="icon-base bx bx-hide"></i></span>
              </div>
              <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4 form-password-toggle">
              <label class="form-label" asp-for="ConfirmPassword"></label>
              <div class="input-group input-group-merge">
                <input asp-for="ConfirmPassword" class="form-control" />
                <span class="input-group-text cursor-pointer"><i class="icon-base bx bx-hide"></i></span>
              </div>
              <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary">Update Password</button>
          </form>
        </div>
      </div>
    </div>
  </div>
}
