@model List<AspnetCoreMvcFull.Entities.AuditLog>
@{
  ViewData["Title"] = "Audit Trail — Astra";
}

<div class="row">
  <div class="col-12">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
      <div>
        <h4 class="fw-bold mb-1"><span class="text-muted fw-light">Security & Compliance /</span> Immutable Audit Trail</h4>
        <p class="text-muted mb-0 small">Append-only log of system mutations, access events, and administrative activities.</p>
      </div>
      <div>
        <a asp-action="ExportCsv" asp-route-search="@ViewBag.Search" asp-route-entityFilter="@ViewBag.EntityFilter" asp-route-actionFilter="@ViewBag.ActionFilter" class="btn btn-outline-primary">
          <i class="bx bx-download me-1"></i> Export to CSV
        </a>
      </div>
    </div>

    <!-- Filter Card -->
    <div class="card mb-4 shadow-sm border-0">
      <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
          <div class="col-md-4">
            <div class="input-group input-group-merge">
              <span class="input-group-text"><i class="bx bx-search"></i></span>
              <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by user, action, details..." />
            </div>
          </div>
          <div class="col-md-2">
            <select name="entityFilter" class="form-select">
              <option value="">All Entities</option>
              @if (ViewBag.Entities is List<string> entities)
              {
                @foreach (var ent in entities)
                {
                  <option value="@ent" selected="@(ViewBag.EntityFilter == ent)">@ent</option>
                }
              }
            </select>
          </div>
          <div class="col-md-2">
            <select name="actionFilter" class="form-select">
              <option value="">All Actions</option>
              @if (ViewBag.Actions is List<string> actions)
              {
                @foreach (var act in actions)
                {
                  <option value="@act" selected="@(ViewBag.ActionFilter == act)">@act</option>
                }
              }
            </select>
          </div>
          <div class="col-md-2">
            <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control" title="From Date" />
          </div>
          <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bx bx-reset"></i></a>
          </div>
        </form>
      </div>
    </div>

    <!-- Audit Table Card -->
    <div class="card shadow-sm border-0">
      <div class="table-responsive text-nowrap">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Timestamp (UTC)</th>
              <th>Action</th>
              <th>Entity</th>
              <th>Target ID</th>
              <th>Actor</th>
              <th>IP Address</th>
              <th class="text-end">Details</th>
            </tr>
          </thead>
          <tbody class="table-border-bottom-0">
            @if (Model.Count == 0)
            {
              <tr>
                <td colspan="7" class="text-center py-5">
                  <div class="text-muted">
                    <i class="bx bx-shield-quarter fs-1 d-block mb-2 text-secondary"></i>
                    <h6>No audit entries found</h6>
                    <p class="small mb-0">No events matched your filtering parameters.</p>
                  </div>
                </td>
              </tr>
            }
            else
            {
              @foreach (var log in Model)
              {
                <tr>
                  <td>
                    <span class="small font-monospace text-muted">@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</span>
                  </td>
                  <td>
                    @{
                      var badgeClass = log.Action switch
                      {
                        "Created" or "Seeded" => "bg-label-success",
                        "Updated" => "bg-label-primary",
                        "RoleChanged" or "PasswordChanged" => "bg-label-info",
                        "Deleted" or "UserDeactivated" or "AccountLockedOut" or "LoginBlocked" => "bg-label-danger",
                        "LoginSuccess" => "bg-label-success",
                        "LoginFailed" => "bg-label-warning",
                        _ => "bg-label-secondary"
                      };
                    }
                    <span class="badge @badgeClass">@log.Action</span>
                  </td>
                  <td>
                    <span class="fw-semibold">@log.Entity</span>
                  </td>
                  <td>
                    <span class="small text-muted font-monospace">@(log.EntityId ?? "—")</span>
                  </td>
                  <td>
                    @if (log.User is not null)
                    {
                      <div class="d-flex align-items-center">
                        <span class="avatar avatar-xs rounded-circle bg-label-primary me-2 text-uppercase d-inline-flex justify-content-center align-items-center" style="width: 24px; height: 24px; font-size: 11px;">
                          @(log.User.Name.Length > 0 ? log.User.Name[..1] : "U")
                        </span>
                        <small class="fw-medium text-heading">@log.User.Email</small>
                      </div>
                    }
                    else
                    {
                      <small class="text-muted">System / Anonymous</small>
                    }
                  </td>
                  <td>
                    <small class="text-muted font-monospace">@(log.IpAddress ?? "—")</small>
                  </td>
                  <td class="text-end">
                    @if (!string.IsNullOrEmpty(log.Details))
                    {
                      <button type="button" class="btn btn-xs btn-outline-primary" data-bs-toggle="modal" data-bs-target="#detailsModal-@log.Id">
                        <i class="bx bx-code-alt me-1"></i> View Diff
                      </button>

                      <!-- Modal for Log Details -->
                      <div class="modal fade" id="detailsModal-@log.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-lg">
                          <div class="modal-content text-start">
                            <div class="modal-header">
                              <h5 class="modal-title">Audit Record #@log.Id — @log.Action @log.Entity</h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                              <div class="mb-3">
                                <span class="badge @badgeClass me-2">@log.Action</span>
                                <span class="text-muted font-monospace small">@log.CreatedAt.ToString("O")</span>
                              </div>
                              <h6 class="small fw-bold text-uppercase text-muted">Payload / State Transition (JSON)</h6>
                              <pre class="bg-dark text-light p-3 rounded" style="max-height: 400px; overflow-y: auto;"><code>@log.Details</code></pre>
                            </div>
                            <div class="modal-footer">
                              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                            </div>
                          </div>
                        </div>
                      </div>
                    }
                    else
                    {
                      <span class="text-muted small">—</span>
                    }
                  </td>
                </tr>
              }
            }
          </tbody>
        </table>
      </div>

      <!-- Pagination Footer -->
      @if (ViewBag.TotalPages > 1)
      {
        <div class="card-footer d-flex justify-content-between align-items-center py-3">
          <small class="text-muted">Showing page @ViewBag.PageNumber of @ViewBag.TotalPages (Total: @ViewBag.TotalCount records)</small>
          <nav aria-label="Audit pagination">
            <ul class="pagination pagination-sm mb-0">
              <li class="page-item @(ViewBag.PageNumber == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(ViewBag.PageNumber - 1)" asp-route-search="@ViewBag.Search" asp-route-entityFilter="@ViewBag.EntityFilter" asp-route-actionFilter="@ViewBag.ActionFilter">Previous</a>
              </li>
              @for (int p = 1; p <= Math.Min((int)ViewBag.TotalPages, 10); p++)
              {
                <li class="page-item @(p == ViewBag.PageNumber ? "active" : "")">
                  <a class="page-link" asp-action="Index" asp-route-pageNumber="@p" asp-route-search="@ViewBag.Search" asp-route-entityFilter="@ViewBag.EntityFilter" asp-route-actionFilter="@ViewBag.ActionFilter">@p</a>
                </li>
              }
              <li class="page-item @(ViewBag.PageNumber == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(ViewBag.PageNumber + 1)" asp-route-search="@ViewBag.Search" asp-route-entityFilter="@ViewBag.EntityFilter" asp-route-actionFilter="@ViewBag.ActionFilter">Next</a>
              </li>
            </ul>
          </nav>
        </div>
      }
    </div>
  </div>
</div>
